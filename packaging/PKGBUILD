# Maintainer: Sykes <jacob@sykes-sec.com>
pkgname=omarchy-theme-creator
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux-native GUI for creating and editing Omarchy themes with a live preview"
arch=('x86_64')
url="https://github.com/jacobsykes/omarchy-theme-creator"
license=('MIT')
depends=('hicolor-icon-theme' 'fontconfig' 'libx11' 'libice' 'libsm' 'glibc')
makedepends=('dotnet-sdk>=10.0' 'git')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  RID=linux-x64 bash packaging/build.sh "$srcdir/publish"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # Single self-contained binary
  install -Dm755 "$srcdir/publish/omarchy-theme-creator" \
    "$pkgdir/usr/bin/omarchy-theme-creator"

  # Desktop entry
  install -Dm644 packaging/omarchy-theme-creator.desktop \
    "$pkgdir/usr/share/applications/omarchy-theme-creator.desktop"

  # Icon (falls back gracefully if absent)
  if [[ -f packaging/icon.png ]]; then
    install -Dm644 packaging/icon.png \
      "$pkgdir/usr/share/pixmaps/omarchy-theme-creator.png"
  fi

  # License
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
